      "html": "<nav class=\"ds-nav\" aria-label=\"Contoh navigasi\"><a class=\"ds-link ds-current\" href=\"#ds-ringkasan\" aria-current=\"location\">Ringkasan</a><a class=\"ds-link\" href=\"#ds-tugas\">Tugas <span class=\"ds-count\">6</span></a><a class=\"ds-link\" href=\"#ds-agenda\">Agenda</a></nav>",
      "css": ".ds-nav{font-family:'Segoe UI', ui-sans-serif, system-ui, sans-serif;display:flex;align-items:stretch;gap:28px}.ds-link{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 5px;border-bottom:2px solid transparent;color:var(--muted,#716775);font-size:13px;text-decoration:none}.ds-link:hover{color:var(--accent,#704760)}.ds-current{color:var(--accent,#704760);border-bottom-color:var(--accent,#704760);font-weight:600}.ds-link:focus-visible{outline:3px solid var(--focus,#936082);outline-offset:4px;}.ds-count{display:grid;place-items:center;min-width:21px;height:21px;padding:0 5px;background:var(--selected,#f0e8ef);color:var(--accent,#704760);border-radius:5px;font-size:11px}@media(max-width:760px){.ds-nav{gap:26px}.ds-link{min-height:48px;font-size:12px}}@media(max-width:400px){.ds-nav{gap:8px;justify-content:space-between}}"
    },
    {
      "name": "Urgent status",
      "kind": "chip",
      "refersTo": "badge-urgent",
      "description": "Warm semantic badge with explicit status text.",
      "html": "<span class=\"ds-badge\"><span class=\"ds-dot\" aria-hidden=\"true\"></span>2 perlu segera</span>",
      "css": ".ds-badge{font-family:'Segoe UI', ui-sans-serif, system-ui, sans-serif;display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:5px;font-size:11px;white-space:nowrap;background:#faf0e6;color:#8b4f28}.ds-dot{width:5px;height:5px;border-radius:50%;background:#af703c}"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat white panel with a fine lavender-neutral border.",
      "html": "<section class=\"ds-panel\"><h2>Agenda hari ini</h2><p>Selasa, 20 Oktober · WIB</p></section>",
      "css": ".ds-panel{font-family:'Segoe UI', ui-sans-serif, system-ui, sans-serif;background:#fff;border:1px solid var(--line,#e8e3e9);border-radius:14px;padding:26px 24px 20px;color:var(--ink,#332c36)}.ds-panel h2{margin:0;font-size:18px;font-weight:600;line-height:1.4;letter-spacing:-.015em}.ds-panel p{margin:5px 0 0;font-size:12px;color:var(--muted,#716775)}"
    },
    {
      "name": "Selected category",
      "kind": "button",
      "refersTo": "filter-selected",
      "description": "Filled pressed-state filter.",
      "html": "<button class=\"ds-filter\" type=\"button\" aria-pressed=\"true\">Semua <span>6</span></button>",
      "css": ".ds-filter{font-family:'Segoe UI', ui-sans-serif, system-ui, sans-serif;min-height:40px;padding:9px 14px;border:0;border-radius:6px;background:var(--selected,#f0e8ef);color:var(--accent,#704760);font-size:12px;font-weight:600;cursor:pointer}.ds-filter span{margin-left:6px;font-size:11px}.ds-filter:hover{color:var(--accent-hover,#523048);background:#f5f1f5}.ds-filter:focus-visible{outline:3px solid var(--focus,#936082);outline-offset:4px;}@media(max-width:760px){.ds-filter{min-height:44px;padding-inline:11px;font-size:11px}}"
    },
    {
      "name": "Inline task disclosure",
      "kind": "custom",
      "refersTo": "task-disclosure",
      "description": "Native disclosure keeps context within the task list.",
      "html": "<details class=\"ds-task\"><summary>Koreksi kehadiran <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg></summary><div class=\"ds-context\">Pemilik tindak lanjut: HR Officer<br>Pratinjau baca saja.</div></details>",
      "css": ".ds-task{font-family:'Segoe UI', ui-sans-serif, system-ui, sans-serif;background:#fff;color:var(--ink,#332c36);border-bottom:1px solid #f0ebf1}.ds-task summary{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px 26px;list-style:none;font-size:13px;font-weight:600;line-height:1.5;cursor:pointer}.ds-task summary::-webkit-details-marker{display:none}.ds-task summary:hover{background:#fcfafd}.ds-task summary:focus-visible{outline:3px solid var(--focus,#936082);outline-offset:4px;}.ds-task[open] summary,.ds-context{background:#f8f4f8}.ds-context{padding:0 26px 22px;font-size:13px;line-height:1.5}.ds-task svg{color:var(--accent,#704760);transition:transform 160ms ease-out}.ds-task[open] svg{transform:rotate(90deg)}@media(prefers-reduced-motion:reduce){.ds-task svg{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Ruang Tim",
    "overview": "Ruang Tim is a light, open workspace with plum actions, neutral dark text, white surfaces, and a barely lavender ground. Its modern character comes from measured spacing, readable type, thin borders, and a small number of clear destinations.\n\nInformation has room to breathe while repeated tasks remain easy to scan. Quiet local states and native disclosures reveal context where it is needed. The current expression is a read-only dashboard with synthetic fixtures; the visual system does not imply operational HR capabilities.",
    "keyCharacteristics": [
      "Open horizontal navigation for the available destinations.",
      "Plum action states on light neutral surfaces.",
      "Readable rows, native controls, and inline context.",
      "Minimal motion with reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Available Destination Rule",
        "body": "Size navigation around destinations that exist, keeping this three-link header directly visible on desktop and mobile.",
        "section": "typography"
      },
      {
        "name": "The State Color Rule",
        "body": "Plum identifies actions and selection. Attendance and urgency colors carry semantic meaning and always have accompanying text.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use white surfaces, fine borders, and spacing to establish hierarchy without decorative shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use plum for action and selected states and retain readable text with semantic status colors.",
      "Do preserve the three visible navigation destinations and align the header with the main container.",
      "Do keep contextual task details beside their originating row and preserve active filters.",
      "Do retain visible focus, native controls, and useful content without JavaScript.",
      "Do label synthetic data and unavailable operations clearly."
    ],
    "donts": [
      "Don't restore the superseded sage rail or add a hamburger for the three current destinations.",
      "Don't add gradients, decorative photos, repeated statistic cards, or entrance animations to this direction.",
      "Don't treat source inspection or a passing build as visual approval or accessibility certification."
    ]
  }
}

[Unit]
Description=HRIS scheduler tick
After=network-online.target

[Service]
Type=oneshot
User=hris
Group=hris
WorkingDirectory=/srv/hris/current
ExecStart=/usr/bin/php artisan schedule:run --no-interaction
TimeoutStartSec=350
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/hris/current/storage /srv/hris/current/bootstrap/cache

# Install only after replacing the domain and certificate paths; web root is public/.
server {
    listen 80;
    server_name replace-with-your-domain.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name replace-with-your-domain.invalid;
    root /srv/hris/current/public;
    index index.php;
    ssl_certificate /etc/letsencrypt/live/replace-with-your-domain.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/replace-with-your-domain.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 12m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/hris-fpm.sock;
        fastcgi_read_timeout 360s;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
